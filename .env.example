BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_ENV=demo

SYMBOL=BTCUSDT
CATEGORY=linear
INTERVAL=15
LOOKBACK=512
HORIZON=8
SAMPLE_PATHS=8
MODEL=NeoQuasar/Kronos-small
TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
DEVICE=cpu

DRY_RUN=true
RISK_PCT=0.01
MAX_LEVERAGE=1
PROB_THRESHOLD=0.60
FEE_BPS=5.5
SLIPPAGE_BPS=2
ATR_K=1.5
RR=1.5
STATE_FILE=data/state.json
LOG_FILE=data/trades.jsonl

HF_HOME=models/hf
HF_HUB_DISABLE_SYMLINKS_WARNING=1

BYBIT_DATA_URL=https://api.bytick.com
BYBIT_TRADE_URL=https://api-demo.bybit.com
